LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

PORTFOLIO_STORAGE_BACKEND=sqlite
PORTFOLIO_DATABASE_URL=
PAPER_LEDGER_DB_PATH=../../data/paper-ledger.db
MARKET_DATA_DB_PATH=../../data/market-data.db

# Generic OIDC Authorization Code + PKCE for protected API identity.
# Leave disabled for local fixture tests that use trusted X-Actor-* headers.
OIDC_AUTH_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_JWKS_JSON=

# Use native/private Ollama by default:
OLLAMA_BASE_URL=http://host.containers.internal:11434
OLLAMA_IMAGE_TAG=0.32.3
OLLAMA_MODEL_DIGEST=sha256:<pinned-local-model-digest>
MODEL_CONTEXT_WINDOW_TOKENS=8192
MODEL_SUPPORTS_TOOL_USE=true
MODEL_SUPPORTS_STRUCTURED_OUTPUTS=true

# Or use Google AI Studio:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-latest
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=False
# ENABLE_CLOUD_TELEMETRY=false

# Or Vertex/Gemini Enterprise Agent Platform:
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True
# ENABLE_CLOUD_TELEMETRY=true
