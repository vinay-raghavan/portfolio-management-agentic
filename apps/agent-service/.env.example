LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest

# Use either Google AI Studio:
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=False

# Or Vertex/Gemini Enterprise Agent Platform:
