LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
GOOGLE_GENAI_USE_VERTEXAI=False
ENABLE_CLOUD_TELEMETRY=false

MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8081
MCP_STREAMABLE_HTTP_PATH=/mcp
MCP_STATELESS_HTTP=true

ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
VITE_AGENT_API_URL=http://localhost:8000

# Production-like local storage. SQLite paths below remain the fast offline
# default for existing stores while Postgres-backed features are ported behind
# migrations and contract tests.
PORTFOLIO_STORAGE_BACKEND=postgres
PORTFOLIO_DATABASE_URL=postgresql+psycopg://portfolio:portfolio-dev-password@localhost:5432/portfolio_agentic
PORTFOLIO_RESEARCH_STORE_BACKEND=fixture
# PORTFOLIO_RESEARCH_STORE_BACKEND=postgres
# PORTFOLIO_RESEARCH_TENANT_ID=<tenant-uuid>
PORTFOLIO_TENANT_ID=11111111-1111-1111-1111-111111111111
PAPER_EXECUTION_WORKER_ID=paper-execution-worker-1
PAPER_EXECUTION_WORKER_MAX_ITEMS=100
PAPER_EXECUTION_WORKER_IDLE_SLEEP_SECONDS=5
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio-dev-password
POSTGRES_DB=portfolio_agentic
POSTGRES_IMAGE_TAG=16-alpine
REDIS_URL=redis://redis:6379/0
REDIS_IMAGE_TAG=7-alpine

PAPER_LEDGER_DB_PATH=data/paper-ledger.db
MARKET_DATA_DB_PATH=data/market-data.db
PROVIDER_CONFIG_DB_PATH=data/provider-config.db

# Data providers default to offline-safe fixtures. The first configured market
# adapter is a read-only JSON snapshot file; keep the file under ignored local
# data paths and do not commit provider exports or real account data.
PORTFOLIO_MARKET_DATA_PROVIDER=fixture
# PORTFOLIO_MARKET_DATA_PROVIDER=json_file
# PORTFOLIO_MARKET_DATA_JSON_PATH=data/market-snapshots.json
PORTFOLIO_UNIVERSE_PROVIDER=fixture
# PORTFOLIO_UNIVERSE_PROVIDER=json_file
# PORTFOLIO_UNIVERSE_JSON_PATH=data/universes.json
PORTFOLIO_FUNDAMENTALS_PROVIDER=fixture
# PORTFOLIO_FUNDAMENTALS_PROVIDER=json_file
# PORTFOLIO_FUNDAMENTALS_JSON_PATH=data/fundamentals.json
PORTFOLIO_SENTIMENT_PROVIDER=fixture
# PORTFOLIO_SENTIMENT_PROVIDER=json_file
# PORTFOLIO_SENTIMENT_JSON_PATH=data/sentiment.json
PORTFOLIO_VOLATILITY_PROVIDER=fixture
# PORTFOLIO_VOLATILITY_PROVIDER=json_file
# PORTFOLIO_VOLATILITY_JSON_PATH=data/volatility.json
PORTFOLIO_MACRO_PROVIDER=fixture
# PORTFOLIO_MACRO_PROVIDER=json_file
# PORTFOLIO_MACRO_JSON_PATH=data/macro.json

# Optional local model profile:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://host.containers.internal:11434
# OLLAMA_IMAGE_TAG=0.32.3
# OLLAMA_MODEL_DIGEST=sha256:<pinned-local-model-digest>
# OLLAMA_STATUS_TIMEOUT_SECONDS=1.5
# OLLAMA_AVAILABLE_MODEL_DIGESTS=llama3.1:8b=sha256:<pinned-local-model-digest>
# MODEL_CONTEXT_WINDOW_TOKENS=8192
# MODEL_SUPPORTS_TOOL_USE=true
# MODEL_SUPPORTS_STRUCTURED_OUTPUTS=true
# MODEL_TUNING_CANDIDATES=llama3.1:8b,gemma:7b,gemma4:12b
# MODEL_TUNING_DEV_SET=agent-service-dev
# MODEL_TUNING_HOLDOUT_SET=agent-service-sealed

# Optional hosted providers, set locally only:
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
