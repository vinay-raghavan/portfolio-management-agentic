LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
GOOGLE_GENAI_USE_VERTEXAI=False

MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8081
MCP_STREAMABLE_HTTP_PATH=/mcp
MCP_STATELESS_HTTP=true

ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000

PAPER_LEDGER_DB_PATH=data/paper-ledger.db

# Data providers default to offline-safe fixtures. Set these locally only when
# a future read-only adapter is implemented and explicitly enabled.
PORTFOLIO_MARKET_DATA_PROVIDER=fixture
PORTFOLIO_UNIVERSE_PROVIDER=fixture
PORTFOLIO_FUNDAMENTALS_PROVIDER=fixture
PORTFOLIO_SENTIMENT_PROVIDER=fixture
PORTFOLIO_VOLATILITY_PROVIDER=fixture
PORTFOLIO_MACRO_PROVIDER=fixture

# Optional local model profile:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://ollama:11434

# Optional hosted providers, set locally only:
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
